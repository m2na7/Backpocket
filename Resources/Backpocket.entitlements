<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Applied only by BACKPOCKET_SANDBOX=1 ./build.sh; the free direct-download
	     build ships unsandboxed and unentitled, exactly as before. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>

	<!-- The favicon fetcher (on by default, a switch in Settings) makes
	     outbound HTTPS GETs to public hosts. Outbound only; no server is ever
	     run. -->
	<key>com.apple.security.network.client</key>
	<true/>

	<!-- Settings > Ignored apps reads chosen application bundles, and
	     Settings > Data exports notes to a destination chosen with NSSavePanel.
	     Read/write access is limited to locations the user explicitly selects.
	     NOTE: this does NOT cover the file-copy feature. Files copied in
	     Finder never pass through a panel, so no user-selected grant reaches
	     them: a stored file pastes back as its path, silently. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
</dict>
</plist>
